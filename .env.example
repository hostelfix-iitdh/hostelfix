# Local development only. Change all passwords before any shared deployment.
# Copy this file to .env. Put your Google Web Client ID and Gemini API key below. Never commit .env.
MYSQL_DATABASE=hostelfix
MYSQL_USER=hostelfix
MYSQL_PASSWORD=hostelfix_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_PORT=3307
API_PORT=8000
ENVIRONMENT=development
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
SESSION_HOURS=24
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GEMINI_API_KEY=PASTE_YOUR_FREE_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=30
AI_MAX_CHARS=500
AI_MAX_IMAGE_BYTES=5242880
AI_DAILY_LIMIT=10
MAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
COOKIE_SECURE=false
